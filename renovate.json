{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "labels": ["renovate"],
  "commitMessagePrefix": "chore(deps):",
  "platformAutomerge": true,
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true
    },
    {
      "matchDepTypes": ["devDependencies"],
      "automerge": true
    },
    {
      "description": "Block sbt major updates until sbt 2 migration is completed, including verifying plugin compatibility, updating build definitions, and deciding how to run the JDK 11/17/19 test matrix with sbt 2.",
      "matchPackageNames": ["sbt/sbt", "org.scala-sbt:sbt"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    }
  ],
  "prHourlyLimit": 0,
  "prConcurrentLimit": 5
}
