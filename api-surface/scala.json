{
  "format": "event-store-adapter-api-surface-mapping",
  "surface_version": "0.1.0",
  "type_parameters": { "P": "P", "A": "A" },
  "value_types": {
    "aggregate_id": "com.github.j5ik2o.event.store.adapter.java.core.AggregateId",
    "seq_nr": "scala.Long",
    "timestamp": "java.time.Instant",
    "string": "java.lang.String"
  },
  "none": "scala.Unit",
  "containers": {
    "optional": "scala.Option",
    "list": "scala.collection.immutable.Seq"
  },
  "types": {
    "event_envelope": {
      "class": "com.github.j5ik2o.event.store.adapter.java.core.EventEnvelope",
      "checked_by": "java"
    },
    "snapshot_envelope": {
      "class": "com.github.j5ik2o.event.store.adapter.java.core.SnapshotEnvelope",
      "checked_by": "java"
    },
    "snapshot_read": {
      "class": "com.github.j5ik2o.event.store.adapter.scala.SnapshotReadResult",
      "accessors": { "snapshot": "snapshot", "head_seq_nr": "headSeqNr" }
    }
  },
  "stores": [
    {
      "trait": "com.github.j5ik2o.event.store.adapter.scala.EventStore",
      "wrap": "scala.util.Try",
      "implicit_parameters": []
    },
    {
      "trait": "com.github.j5ik2o.event.store.adapter.scala.EventStoreAsync",
      "wrap": "scala.concurrent.Future",
      "implicit_parameters": ["scala.concurrent.ExecutionContext"]
    }
  ],
  "operations": {
    "persist_event": "persistEvent",
    "persist_event_and_snapshot": "persistEventAndSnapshot",
    "get_latest_snapshot_by_id": "getLatestSnapshotById",
    "get_events_by_id_since_seq_nr": "getEventsByIdSinceSeqNr"
  },
  "error_categories": {
    "checked_by": "java",
    "names": {
      "optimistic_lock": "com.github.j5ik2o.event.store.adapter.java.core.OptimisticLockException",
      "contract_violation": "com.github.j5ik2o.event.store.adapter.java.core.ContractViolationException",
      "serialization": "com.github.j5ik2o.event.store.adapter.java.core.SerializationException",
      "configuration": "com.github.j5ik2o.event.store.adapter.java.core.ConfigurationException",
      "storage": "com.github.j5ik2o.event.store.adapter.java.core.StorageException"
    }
  }
}
